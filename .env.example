# ============================================================
#  SFMEWS — Contoh Konfigurasi
# ============================================================
#  Salin berkas ini menjadi .env lalu isi nilainya:
#      cp .env.example .env
#
#  Nilai bertanda GANTI_NILAI_INI dan yang bertuliskan "ganti_..."
#  WAJIB diisi sendiri. Jangan pernah mengomit .env yang sudah terisi.
# ============================================================

# ================================================================
# SMART FLOOD MONITORING SYSTEM — Docker Environment Variables
# ================================================================

# ===================== GENERAL =====================
COMPOSE_PROJECT_NAME=smart_flood_system

# ===================== MONGODB =====================
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=ganti_sandi_mongo_anda
MONGO_DATABASE=smart_flood_monitoring
MONGO_URL=mongodb://root:ganti_sandi_mongo_anda@mongodb:27017/smart_flood_monitoring?authSource=admin

# ===================== MOSQUITTO MQTT =====================
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=iot/weather
MQTT_USERNAME=iotdevice
MQTT_PASSWORD=ganti_sandi_mqtt_anda

# ===================== FASTAPI BACKEND =====================
FASTAPI_PORT=8000

# ===================== AI ENGINE =====================
AI_ENGINE_PORT=5000

# ===================== LARAVEL =====================
APP_NAME="Smart Flood Monitoring"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=base64:JALANKAN__php_artisan_key:generate

# ===================== LARAVEL MONGODB =====================
# Laravel also connects to MongoDB for sensor + AI detection data
LARAVEL_MONGO_URL=mongodb://root:ganti_sandi_mongo_anda@mongodb:27017/smart_flood_monitoring?authSource=admin

# ===================== OPENWEATHER =====================
OPENWEATHER_API_KEY=isi_kunci_api_openweathermap_anda

# ===================== SERVICES URL (for Laravel) =====================
FASTAPI_URL=http://fastapi-backend:8000
AI_ENGINE_URL=http://ai-engine:5000

# ---- Akun pengelola awal (LOKAL saja) ----
# Ditambahkan 2 Agu 2026: docker-compose mendeklarasikan ketiga kunci ini,
# sehingga bila kosong ia MENIMPA nilai bawaan di auth.py dan akun gagal dibuat.
ADMIN_EMAIL=admin@contoh.local
ADMIN_PASSWORD=ganti_sandi_admin_anda
ADMIN_NAME="Administrator Lokal"
