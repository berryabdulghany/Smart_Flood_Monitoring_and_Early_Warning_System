# ================================================================
# .dockerignore — Root Level (untuk docker-compose context)
# ================================================================

# ===== PALING PENTING: Exclude folder besar =====
**/node_modules
**/vendor

# Git
**/.git
**/.gitignore
**/.gitattributes
**/.github

# Python cache
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd

# Laravel runtime files
Smart_Flood_Monitoring_and_Early_Warning_System/storage/logs/*
Smart_Flood_Monitoring_and_Early_Warning_System/storage/framework/cache/*
Smart_Flood_Monitoring_and_Early_Warning_System/storage/framework/sessions/*
Smart_Flood_Monitoring_and_Early_Warning_System/storage/framework/views/*
Smart_Flood_Monitoring_and_Early_Warning_System/bootstrap/cache/*.php

# AI uploads (runtime)
ai-engine/uploads/*

# Env files
**/.env
**/.env.*

# Editor
**/.vscode
**/.idea
**/*.swp

# OS
**/Thumbs.db
**/.DS_Store

# Logs
**/*.log

# Test files
**/tests
**/phpunit.xml
**/.phpunit.result.cache
